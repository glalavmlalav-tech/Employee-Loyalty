{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/:path*"
    },
    {
      "source": "/security",
      "destination": "/index.html"
    },
    {
      "source": "/security/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/guard",
      "destination": "/index.html"
    },
    {
      "source": "/gate",
      "destination": "/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
